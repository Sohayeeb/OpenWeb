{
  "name": "@openweb/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The OpenWeb desktop browser: a peer-to-peer web in a single window.",
  "author": "OpenWeb",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron dist/main.cjs",
    "package": "node build.mjs --package",
    "package:dir": "node build.mjs --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "fs-native-extensions": "^1.5.3",
    "quickbit-native": "^2.4.9",
    "rabin-native": "^2.0.1",
    "rocksdb-native": "^3.19.3",
    "simdle-native": "^1.3.10",
    "sodium-native": "^5.2.0",
    "udx-native": "^1.22.0"
  }
}
